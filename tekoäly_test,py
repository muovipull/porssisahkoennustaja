def lataa_oma_tuulivoimaennuste(tiedosto_polku):
    """Lataa ja pyöristää oman tuulivoimaennusteen ajat tasatunneille."""
    if os.path.exists(tiedosto_polku):
        try:
            df_tuuli = pd.read_csv(tiedosto_polku)
            df_tuuli["aika_fi"] = pd.to_datetime(df_tuuli["aika_fi"], utc=True).dt.tz_convert("Europe/Helsinki").dt.floor("h")
            print(f" Ladattu oma tuulivoimaennuste tiedostosta '{tiedosto_polku}' ({len(df_tuuli)} riviä).")
            return df_tuuli.sort_values("aika_fi").reset_index(drop=True)
        except Exception as e:
            print(f" Virhe tuulivoimaennusteen luvussa: {e}")
    else:
        print(f" Varoitus: Tiedostoa '{tiedosto_polku}' ei löytynyt. Käytetään oletusarvoja.")
    return pd.DataFrame()

def hae_fingrid_dataset(dataset_id):
    """Haetaan Fingrid-dataset sallitulla max-sivukoolla (1000)."""
    url = f"https://data.fingrid.fi/api/datasets/{dataset_id}/data"
    kaikki_data = []
    page = 1
    
    while True:
        params = {
            "startTime": start_str,
            "endTime": end_str,
            "pageSize": 1000,
            "page": page
        }
        try:
            res = requests.get(url, headers=headers, params=params, timeout=10)
            if res.status_code == 429:
                time.sleep(1.5)
                continue
            res.raise_for_status()
            json_data = res.json()
            sivu = json_data.get("data", [])
            if not sivu:
                break
            kaikki_data.extend(sivu)
            if page >= json_data.get("pagination", {}).get("lastPage", 1):
                break
            page += 1
            time.sleep(0.02)
        except Exception as e:
            print(f" Virhe Fingrid datasetissä {dataset_id}: {e}")
            break
            
    if not kaikki_data:
        return pd.DataFrame()
        
    df = pd.DataFrame(kaikki_data)
    df["startTime"] = pd.to_datetime(df["startTime"])
    df["aika_fi"] = df["startTime"].dt.tz_convert("Europe/Helsinki").dt.floor("h")
    df = df.sort_values("aika_fi").reset_index(drop=True)
    return df[["aika_fi", "value"]]

def hae_lampotila_data():
    """Haetaan lämpötila Open-Meteo APIsta."""
    url = "https://api.open-meteo.com/v1/forecast"
    params = {
        "latitude": 62.0, "longitude": 25.0, "hourly": "temperature_2m",
        "past_days": 14, "forecast_days": 3, "timezone": "Europe/Helsinki"
    }
    try:
        res = requests.get(url, params=params, timeout=5)
        if res.status_code == 200:
            data = res.json()["hourly"]
            aika_sarja = pd.to_datetime(data["time"])
            aika_sarja = aika_sarja.tz_localize("Europe/Helsinki") if aika_sarja.tz is None else aika_sarja.tz_convert("Europe/Helsinki")
            return pd.DataFrame({"aika_fi": aika_sarja.dt.floor("h"), "lampotila": data["temperature_2m"]})
    except Exception:
        pass
    return pd.DataFrame()

def hae_porssihinnat():
    """Haetaan Suomen pörssisähkön hinnat."""
    try:
        res = requests.get("https://porssisahko.net/api/v1/latest.json", timeout=6)
        if res.status_code == 200:
            data = res.json().get("prices", [])
            if data:
                df = pd.DataFrame(data)
                df["aika_fi"] = pd.to_datetime(df["startDate"]).dt.tz_convert("Europe/Helsinki").dt.floor("h")
                df["hinta_cents"] = df["price"]
                return df[["aika_fi", "hinta_cents"]]
    except Exception:
        pass

    try:
        res = requests.get("https://api.spot-hinta.fi/v1/TodayAndDayForward", timeout=6)
        if res.status_code == 200:
            df = pd.DataFrame(res.json())
            if "DateTime" in df.columns and "PriceWithTax" in df.columns:
                df["aika_fi"] = pd.to_datetime(df["DateTime"]).dt.tz_convert("Europe/Helsinki").dt.floor("h")
                df["hinta_cents"] = df["PriceWithTax"] * 100
                return df[["aika_fi", "hinta_cents"]]
    except Exception:
        pass

    return pd.DataFrame()

def hae_ja_yhdista_kaikki_data():
    if os.path.exists(CACHE_FILE):
        file_mod_time = datetime.fromtimestamp(os.path.getmtime(CACHE_FILE), tz=timezone.utc)
        if (nyt_utc - file_mod_time) < timedelta(hours=CACHE_MAX_AGE_HOURS):
            df = pd.read_csv(CACHE_FILE)
            df["aika_fi"] = pd.to_datetime(df["aika_fi"], utc=True).dt.tz_convert("Europe/Helsinki").dt.floor("h")
            if "hinta_cents" in df.columns and "lampotila" in df.columns and "kulutus_toteutunut" in df.columns:
                print(f" Ladataan yhdistetty data välimuistista ('{CACHE_FILE}')...")
                return df

    print(" Haetaan data kaikkialta rajapinnoista...")
    yhdistetty_df = None

    for nimi, ds_id in DATASETS.items():
        print(f"   -> Fingrid: {nimi}...")
        df_temp = hae_fingrid_dataset(ds_id)
        if not df_temp.empty:
            df_temp = df_temp.rename(columns={"value": nimi})
            yhdistetty_df = df_temp if yhdistetty_df is None else pd.merge_asof(yhdistetty_df, df_temp, on="aika_fi", direction="nearest")

    if yhdistetty_df is None or yhdistetty_df.empty:
        print(" Virhe: Fingrid-dataa ei saatu. Tarkista verkkoyhteys / API-avain.")
        return pd.DataFrame()

    print("   -> Lämpötila (Open-Meteo)...")
    df_w = hae_lampotila_data()
    if not df_w.empty:
        yhdistetty_df = pd.merge_asof(yhdistetty_df, df_w, on="aika_fi", direction="nearest")
    else:
        yhdistetty_df["lampotila"] = 10.0

    print("   -> Sähkön pörssihinnat...")
    df_h = hae_porssihinnat()
    if not df_h.empty:
        yhdistetty_df = pd.merge_asof(yhdistetty_df, df_h, on="aika_fi", direction="nearest")
    else:
        print(" Varoitus: Pörssihinta-API ei vastannut. Käytetään laskennallista pohjaa...")
        if "kulutus_toteutunut" in yhdistetty_df.columns and "tuulivoima_toteutunut" in yhdistetty_df.columns:
            yhdistetty_df["hinta_cents"] = (yhdistetty_df["kulutus_toteutunut"] - yhdistetty_df["tuulivoima_toteutunut"]) * 0.001
        else:
            yhdistetty_df["hinta_cents"] = 5.0

    yhdistetty_df = yhdistetty_df.dropna().reset_index(drop=True)
    yhdistetty_df.to_csv(CACHE_FILE, index=False)
    print(f" Data valmis ja tallennettu välimuistiin: '{CACHE_FILE}'")
    return yhdistetty_df

# --- 3. PÄÄOHJELMA & DIRECT FORECASTING ---

df_oma_tuuli = lataa_oma_tuulivoimaennuste(TUULIENNUSTE_TIEDOSTO)
df = hae_ja_yhdista_kaikki_data()

if df.empty or "hinta_cents" not in df.columns or "lampotila" not in df.columns:
    print("\n Datan haku epäonnistui. Poista 'fingrid_full_model_cache.csv' ja suorita uudelleen.")
else:
    df["tunti"] = df["aika_fi"].dt.hour
    df["viikonpaiva"] = df["aika_fi"].dt.dayofweek
    df["kuukausi"] = df["aika_fi"].dt.month
    df["on_viikonloppu"] = df["viikonpaiva"].apply(lambda x: 1 if x >= 5 else 0)
    df["huipputunti"] = df["tunti"].apply(lambda t: 1 if 7 <= t <= 20 else 0)

    df["jaannoskuorma_MW"] = df["kulutus_toteutunut"] - (df["tuulivoima_toteutunut"] + df["aurinkovoima_ennuste"])
    df["tuuli_osuus"] = df["tuulivoima_toteutunut"] / (df["kulutus_toteutunut"] + 1e-5)
    df["nettosiirto_yhteensa"] = df["siirto_ruotsi_se1"] + df["siirto_ruotsi_se3"] + df["siirto_viro"]

    feature_cols = [
        "tunti", "viikonpaiva", "kuukausi", "on_viikonloppu", "huipputunti",
        "lampotila", "kulutus_ennuste", "tuulivoima_ennuste", "aurinkovoima_ennuste",
        "ydinvoima_toteutunut", "vesivoima_toteutunut", "yhteistuotanto_chp",
        "teholauhdutus_varavoima", "jaannoskuorma_MW", "tuuli_osuus",
        "nettosiirto_yhteensa", "hinta_cents"
    ]

    # Luodaan 24 kohdesaraketta
    for h in range(1, 25):
        df[f"target_{h}h"] = df["hinta_cents"].shift(-h)

    df_clean = df.dropna().copy()
    X = df_clean[feature_cols]

    viimeisin = df_clean.iloc[-1]
    viimeisin_aika_tunti = viimeisin["aika_fi"].floor("h")

    print("\n" + "="*65)
    print(f" SÄHKÖN PÖRSSIHINNAN DIRECT-ENNUSTE SEURAAVALLE 24 TUNNILLE")
    print(" (Käytetään omaa tuulivoimaennustetta ja Direct LightGBM -malleja)")
    print("="*65)

    tuntikohtainen_kulutuskerroin = {
        0: 0.80, 1: 0.75, 2: 0.72, 3: 0.70, 4: 0.72, 5: 0.78,
        6: 0.88, 7: 1.02, 8: 1.10, 9: 1.12, 10: 1.08, 11: 1.05,
        12: 1.00, 13: 0.98, 14: 1.02, 15: 1.08, 16: 1.18, 17: 1.28,
        18: 1.35, 19: 1.32, 20: 1.20, 21: 1.05, 22: 0.92, 23: 0.85
    }

    for h in range(1, 25):
        tuleva_aika = (viimeisin_aika_tunti + timedelta(hours=h)).floor("h")
        tunti = tuleva_aika.hour
        
        # 1. Tuleva kulutus
        kerroin = tuntikohtainen_kulutuskerroin[tunti]
        tuleva_kulutus = viimeisin["kulutus_ennuste"] * kerroin
        
        # 2. Oma tuuli-ennuste CSV:stä
        tuleva_tuuli = 2500.0
        if not df_oma_tuuli.empty:
            match = df_oma_tuuli[df_oma_tuuli["aika_fi"] == tuleva_aika]
            if not match.empty and "oma_lgbm_ennuste_MW" in match.columns:
                tuleva_tuuli = match["oma_lgbm_ennuste_MW"].values[0]

        tuleva_aurinko = viimeisin["aurinkovoima_ennuste"] if 8 <= tunti <= 17 else 0.0

        syote_h = pd.DataFrame([{
            "tunti": tunti,
            "viikonpaiva": tuleva_aika.dayofweek,
            "kuukausi": tuleva_aika.month,
            "on_viikonloppu": 1 if tuleva_aika.dayofweek >= 5 else 0,
            "huipputunti": 1 if 7 <= tunti <= 20 else 0,
            "lampotila": viimeisin["lampotila"],
            "kulutus_ennuste": tuleva_kulutus,
            "tuulivoima_ennuste": tuleva_tuuli,
            "aurinkovoima_ennuste": tuleva_aurinko,
            "ydinvoima_toteutunut": viimeisin["ydinvoima_toteutunut"],
            "vesivoima_toteutunut": viimeisin["vesivoima_toteutunut"],
            "yhteistuotanto_chp": viimeisin["yhteistuotanto_chp"],
            "teholauhdutus_varavoima": viimeisin["teholauhdutus_varavoima"],
            "jaannoskuorma_MW": tuleva_kulutus - (tuleva_tuuli + tuleva_aurinko),
            "tuuli_osuus": tuleva_tuuli / (tuleva_kulutus + 1e-5),
            "nettosiirto_yhteensa": viimeisin["nettosiirto_yhteensa"],
            "hinta_cents": viimeisin["hinta_cents"]
        }])

        # Koulutetaan nopea Direct-malli tunnille h
        y_h = df_clean[f"target_{h}h"]
        malli_h = LGBMRegressor(n_estimators=100, learning_rate=0.05, random_state=42, verbosity=-1)
        malli_h.fit(X, y_h)

        ennustettu_hinta = malli_h.predict(syote_h)[0]

        taso = "HALPA" if ennustettu_hinta < 5.0 else ("KOHTUULLINEN" if ennustettu_hinta < 10.0 else "KALLIS")
        print(f"{tuleva_aika.strftime('%d.%m. %H:%M')} (+{h:2d}h) -->  {ennustettu_hinta:6.2f} c/kWh   [{taso}]  (Tuuli: {tuleva_tuuli:.0f} MW)")

    print("="*65)