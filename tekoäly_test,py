# Määritetään aikaväli (viimeiset 14 päivää)
nyt_utc = datetime.now(timezone.utc)
alku_utc = nyt_utc - timedelta(days=14)

start_str = alku_utc.strftime("%Y-%m-%dT%H:%M:%SZ")
end_str = nyt_utc.strftime("%Y-%m-%dT%H:%M:%SZ")

headers = {
    "x-api-key": API_KEY,
    "Accept": "application/json"
}

def hae_fingrid_data(dataset_id):
    """Haetaan data Fingridistä sivutuksella."""
    url = f"https://data.fingrid.fi/api/datasets/{dataset_id}/data"
    kaikki_data = []
    page = 1
    
    while True:
        params = {
            "startTime": start_str,
            "endTime": end_str,
            "pageSize": 1000,
            "page": page
        }
        
        try:
            response = requests.get(url, headers=headers, params=params, timeout=10)
            
            if response.status_code == 429:
                print(" Odotetaan 3 sekuntia (API-rajoitus hit)...")
                time.sleep(3)
                continue
                
            response.raise_for_status()
            
            json_data = response.json()
            sivun_data = json_data.get("data", [])
            
            if not sivun_data:
                break
                
            kaikki_data.extend(sivun_data)
            
            pagination = json_data.get("pagination", {})
            if page >= pagination.get("lastPage", 1):
                break
                
            page += 1
            time.sleep(0.3)

        except Exception as e:
            print(f"\n Virhe datan haussa (Dataset {dataset_id}): {e}")
            break
            
    if not kaikki_data:
        return pd.DataFrame()
        
    df = pd.DataFrame(kaikki_data)
    df["startTime"] = pd.to_datetime(df["startTime"])
    df["aika_fi"] = df["startTime"].dt.tz_convert("Europe/Helsinki")
    df = df.sort_values("aika_fi").reset_index(drop=True)
    return df[["aika_fi", "value"]]

def hae_yhdistetty_data_cachella():
    """Tarkistaa löytyykö kelvollinen välimuisti levyltä, muuten hakee APIsta."""
    if os.path.exists(CACHE_FILE):
        file_mod_time = datetime.fromtimestamp(os.path.getmtime(CACHE_FILE), tz=timezone.utc)
        age = nyt_utc - file_mod_time
        
        if age < timedelta(hours=CACHE_MAX_AGE_HOURS):
            print(f" Ladataan data paikallisesta välimuistista ('{CACHE_FILE}')...")
            df = pd.read_csv(CACHE_FILE)
            # Muunnetaan merkkijono Aikavyöhykkeelliseksi datetime-olioksi (Europe/Helsinki)
            df["aika_fi"] = pd.to_datetime(df["aika_fi"], utc=True).dt.tz_convert("Europe/Helsinki")
            return df

    print(" Välimuistia ei löydy tai se on vanhentunut. Haetaan data Fingridistä...")
    
    print("1/2 Haetaan toteutunut kulutus (124)...")
    df_toteutunut = hae_fingrid_data(DATASET_TOTEUTUNUT)

    time.sleep(1.5)

    print("2/2 Haetaan Fingridin ennuste (192)...")
    df_fingrid_ennuste = hae_fingrid_data(DATASET_ENNUSTE)

    if df_toteutunut.empty or df_fingrid_ennuste.empty:
        return pd.DataFrame()

    df = pd.merge_asof(
        df_toteutunut.rename(columns={"value": "toteutunut_MW"}),
        df_fingrid_ennuste.rename(columns={"value": "fingrid_ennuste_MW"}),
        on="aika_fi",
        direction="nearest"
    ).dropna()

    # Tallennetaan välimuistiin
    df.to_csv(CACHE_FILE, index=False)
    print(f" Data tallennettu välimuistiin: '{CACHE_FILE}'")
    return df

